generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("CLIENT") // CLIENT | OPERATOR
  inn          String?       // ИНН компании/ИП для автозаполнения заявок (редактируется в профиле)
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Company {
  inn          String        @id
  name         String
  okved        String?
  headName     String?
  revenueYear  Int           @default(0)
  expenseYear  Int           @default(0)
  active       Boolean       @default(true)
  taxArrears   Boolean       @default(false)
  applications Application[]
}

model Product {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  tagline     String
  description String
  minAmount   Int
  maxAmount   Int
  minTerm     Int
  maxTerm     Int
  rate        Float
  applications Application[]
}

model Application {
  id             String   @id @default(cuid())
  number         String   @unique
  userId         String
  companyInn     String
  productId      String
  amount         Int
  term           Int
  goal           String
  status         String   @default("DRAFT")
  score          Int?
  decisionReason String?
  conditions     String?  // JSON {amount, term, rate, monthlyPayment}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  company        Company  @relation(fields: [companyInn], references: [inn])
  product        Product  @relation(fields: [productId], references: [id])
  events         Event[]
}

model Event {
  id            String      @id @default(cuid())
  applicationId String
  type          String      // INFO | CHECK | SCORE | DECISION | ACTION
  message       String
  meta          String?     // JSON (например: {score, factors})
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
